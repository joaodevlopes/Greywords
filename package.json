{
  "name": "greywords",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\" \"server/**/*.test.js\" \"worker/**/*.test.js\" \"catalog/**/*.test.mjs\"",
    "check:ui": "node node_modules/beds/scripts/check-consumer.mjs src",
    "catalog": "node catalog/build.mjs",
    "catalog:check": "node catalog/check.mjs",
    "deploy:images": "npx wrangler deploy",
    "deploy:site": "npm run build && npx wrangler deploy --config wrangler.site.toml"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "beds": "https://github.com/meunomeebero/beds/releases/download/v0.2.0-rc.2/beds-0.2.0-rc.2.tgz",
    "canvas-confetti": "^1.9.4",
    "motion": "^13.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^8.3.4"
  }
}
